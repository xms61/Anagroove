# Anagroove Environment Configuration
# NEVER COMMIT REAL API KEYS TO GIT. No third-party API keys are required.

# API/WebSocket server port (dev default 3001; production default 3000)
PORT=3001

# Vite dev client port (default 3000)
# VITE_PORT=3000

# Other browser origins allowed to call the API, comma-separated. The page's own origin is
# always allowed; unset = localhost dev origins only
# CORS_ALLOWED_ORIGINS=https://example.com

# Set when behind a reverse proxy: hop count ("1"), "true", or a range name ("loopback").
# Unset = X-Forwarded-For is ignored, and every player behind the proxy shares its IP's
# rate limits (120 API requests/min, 20 WebSocket connections).
# TRUST_PROXY=1

# Directory for users.sqlite and the SQLite catalogs (default server/data)
# SPOTYSPICE_DATA_DIR=./server/data

# Skip the VACUUM INTO backup written before catalog schema migrations
# SPOTYSPICE_SKIP_DB_BACKUP=1

# 1 = serve puzzles from the local catalog only (no Deezer/iTunes fallback, no preview lookups)
# SPOTYSPICE_OFFLINE=1

# debug | info | warn | error | none
# LOG_LEVEL=info
