{
  "name": "anagroove",
  "private": true,
  "version": "1.28.10",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "concurrently \"node server/server.ts\" \"vite\"",
    "dev:client": "vite",
    "dev:server": "node server/server.ts",
    "build": "tsc && vite build",
    "start": "node server/server.ts",
    "preview": "vite preview",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "test": "node --import ./scripts/tests/setup_env.ts --test --test-force-exit --test-reporter=dot \"scripts/tests/*.test.ts\"",
    "test:coverage": "c8 npm test && c8 check-coverage --lines 85 --functions 85 --branches 75 --include \"server/db/**\" --include \"server/policy/**\" --include \"shared/**\"",
    "test:web": "vitest run",
    "test:e2e": "playwright test",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.node.json && tsc -p tsconfig.tests.json",
    "test:ci": "npm run lint && npm run typecheck && npm run test:coverage && npm run test:web && npm run db:gate:fixture",
    "db:gate:fixture": "node scripts/tests/fixtures/ciGate.ts",
    "crawl": "node scripts/crawl_catalog.ts",
    "crawl:artists": "node scripts/crawl_catalog.ts --artists=500",
    "crawl:playlists": "node scripts/crawl_catalog.ts --playlists-only",
    "crawl:top10k": "node scripts/ingest_annas_spotify.ts --min-popularity=31",
    "crawl:status": "node scripts/crawl_catalog.ts --status",
    "db:migrate": "node scripts/migrate_catalog.ts",
    "catalog:enrich": "node scripts/enrich_catalog.ts",
    "catalog:coverage": "node scripts/catalog_coverage.ts",
    "catalog:recompute": "node scripts/recompute_catalog.ts",
    "catalog:genres": "node scripts/populate_artist_genres.ts",
    "db:validate": "node scripts/validate_and_sanitize_db.ts",
    "db:sanitize": "node scripts/validate_and_sanitize_db.ts --fix",
    "anime:sync": "node scripts/sync_anime_metadata.ts",
    "anime:samples": "node scripts/generate_anime_samples.ts",
    "anime:ingest": "node scripts/ingest_anime_catalog.ts",
    "anime:images": "node scripts/backfill_anime_images.ts",
    "fetch:datasets": "node scripts/fetch_datasets.ts",
    "ingest:dataset": "node scripts/ingest_musicmovearr.ts"
  },
  "dependencies": {
    "@fontsource/barlow-condensed": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/plus-jakarta-sans": "^5.3.0",
    "@fontsource/zen-kaku-gothic-new": "^5.3.0",
    "canvas-confetti": "^1.9.4",
    "cors": "^2.8.5",
    "eld": "^2.1.0",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/canvas-confetti": "^1.9.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.25",
    "@types/node": "^24.13.6",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/ws": "^8.5.14",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "c8": "^12.0.0",
    "concurrently": "^9.1.2",
    "eslint": "^10.10.0",
    "jsdom": "^30.1.1",
    "postcss": "^8.5.1",
    "prettier": "^3.9.7",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.1.0",
    "vitest": "^5.0.1"
  }
}
